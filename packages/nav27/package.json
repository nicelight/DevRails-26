{
  "name": "devrails-nav27",
  "version": "0.1.0",
  "type": "module",
  "description": "DevRails native DSH workflow controller, schematic navigation and Side consultations",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./role": "./lib/role.js",
    "./client": "./lib/client.js",
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./package.json": "./package.json",
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/role.js",
    "lib/client.js",
    "lib/web/**",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts",
    "resources/**",
    "lib/types.js",
    "lib/types/**"
  ],
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "preview": "node scripts/preview.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.6-alpha.1",
    "@deepseek-ai/dsh-agent": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-session": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-session-query": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-shell": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-shell-env": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-subagent": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-tool-bash": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-tool-executor-native": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-tool-fs": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-tools": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-workspace": "0.2.2-alpha.2"
  },
  "dependencies": {
    "ajv": "^8.17.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis-plugin-include": "1.0.11-alpha.1",
    "@deepseek-ai/cordis-plugin-loader": "1.0.7-alpha.1",
    "@deepseek-ai/dsh-agent-loop": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-agent-loop-testkit": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-api-gateway": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-api-remote-access": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-api-remotes": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-api-session-controller": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-bash-local": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-connection": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-workspace": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-host-webserver": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-storage-json": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-subagent-spawn-in-process": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-subprocess-local": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-typert-generator": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-typert-registry": "0.2.2-alpha.2",
    "@types/node": "^22.20.1",
    "svelte": "^5.0.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3"
  }
}
